module vga_graphics (
    input wire  [9:0] h_count,
    input wire  [9:0] v_count,
	 input wire  video_on,
    output reg [3:0] R,
	 output reg [3:0] G,
	 output reg [3:0] B
);

	parameter H_rad_centro = 320;
	parameter V_rad_centro = 460;
	parameter r0 = 4;  					// semicerchio 3 cm
	parameter r1 = 44;					// semicerchio 30 cm
	parameter r2 = 441;					// semicerchio 300 cm
	parameter H_VISIBLE = 640;
	parameter V_VISIBLE = 480;
	
	always @(*) begin
		if (video_on == 1)
		begin
			 if (99 < h_count < 441 && 19 < v_count < 461) 			// quadrato dove disegnare, margine di 20 sopra e sotto
			 begin
				if(	//equazioni dei cerchi, cambia solo il raggio
					((h_count-H_rad_centro)^2+(v_count-V_rad_centro)^2==r0^2) &&
					((h_count-H_rad_centro)^2+(v_count-V_rad_centro)^2==r1^2) &&
					((h_count-H_rad_centro)^2+(v_count-V_rad_centro)^2==r2^2)
					)
				begin
						R = 10'b0000;
						B = 10'b0000;
						G = 10'b1111;
				end
				else begin
						R = 10'b0000;
						B = 10'b0000;
						G = 10'b0000;
				end
				if(h_count == 320 || v_count == 240) //rette di sfondo
				begin
					   R = 10'b0000;
						B = 10'b0000;
						G = 10'b0111;
			   end
				else begin
						R = 10'b0000;
						B = 10'b0000;
						G = 10'b0000;
				end
			 end
			end
			else begin
			R = 10'b0000;
			B = 10'b0000;
			G = 10'b0000;
			end
			end
endmodule