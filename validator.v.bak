module validation  #(
	parameter MAXCOUNT = 20'd1030000,
	parameter MINCOUNT = 20'd4375
)(
	input [11:0] in,  // binary
	output reg valid  // 1 se il conteggio è compreso tra MIN e MAXCOUNT, 0 se satura a questi valori
);

always @ (*) begin
	if (in == MAXCOUNT || in < MINCOUNT) valid <= 1'b0;
	else valid <= 1'b1;
end

endmodule