module dutycycle (en, duty_cycle);
input en;                  //en = enable per controllorare o meno il modulo, clk = clock a 2 KHz
output [5:0] duty_cycle;   //duty_cycle per pilotare il motore (2.5% - 97.5%)

//contatore fino a 40 (0-39)
reg [5:0] count = 0;

always @(*) begin
	if (en) begin

		duty_cycle <= 6'd4;
		
	end else begin
	
		duty_cycle <= 6'd3;
		
	end
end
    
endmodule