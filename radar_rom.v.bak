module radar_rom (
    input  wire        clk,
    input  wire [17:0] addr,   // 638 * 399 = 254,562 < 2^18
    output reg  [3:0]  data
);

    reg [3:0] rom [0:254561];

    initial begin
        $readmemb("radar_green.txt", rom);
    end

    always @(posedge clk)
        data <= rom[addr];

endmodule