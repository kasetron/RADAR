module vga_controller (
    input  wire       clk_pix,   // clock pixel = 25 MHz, dobbiamo usare un divisore (E-FF)
    input  wire       reset,     // reset attivo alto
    output reg        hsync,     // sync orizzontale (active-low)
    output reg        vsync,     // sync verticale   (active-low)
    output wire       video_on,  // 1 quando siamo nell'area visibile
    output wire [9:0] x,         // coordinata X pixel 
    output wire [9:0] y          // coordinata Y pixel
);

    // Parametri VGA 640x480 @60 Hz, vedi slide di NanniPietro

    parameter H_VISIBLE     = 640; 
    parameter H_FRONT_PORCH = 16;
    parameter H_SYNC_PULSE  = 96;
    parameter H_BACK_PORCH  = 48;
    parameter H_TOTAL       = H_VISIBLE + H_FRONT_PORCH + H_SYNC_PULSE + H_BACK_PORCH; // 800

    parameter V_VISIBLE     = 480;
    parameter V_FRONT_PORCH = 10;
    parameter V_SYNC_PULSE  = 2;
    parameter V_BACK_PORCH  = 33;
    parameter V_TOTAL       = V_VISIBLE + V_FRONT_PORCH + V_SYNC_PULSE + V_BACK_PORCH; // 525

    
    // Contatori orizzontale/verticale
    
    reg [9:0] h_count = 10'd0;  // 0..799
    reg [9:0] v_count = 10'd0;  // 0..524

    // Contatore orizzontale: avanza a ogni pixel
    always @(posedge clk_pix or posedge reset) begin
        if (reset) begin
            h_count <= 10'd0;
        end else begin
            if (h_count == H_TOTAL-1)      // 799
                h_count <= 10'd0;
            else
                h_count <= h_count + 1'b1;
        end
    end

    // Contatore verticale: avanza a fine riga
    always @(posedge clk_pix or posedge reset) begin
        if (reset) begin
            v_count <= 10'd0;
        end else begin
            if (h_count == H_TOTAL-1) begin
                if (v_count == V_TOTAL-1)  // 524
                    v_count <= 10'd0;
                else
                    v_count <= v_count + 1'b1;
            end
        end
    end

    // Generazione hsync / vsync (active-low)
    // hsync low quando h_count sta tra 656 e 751

    always @* begin
        if (h_count >= (H_VISIBLE + H_FRONT_PORCH) &&
            h_count <  (H_VISIBLE + H_FRONT_PORCH + H_SYNC_PULSE))
            hsync = 1'b0;
        else
            hsync = 1'b1;
    end

    // vsync low quando v_count sta tra 490 e 491
    always @* begin
        if (v_count >= (V_VISIBLE + V_FRONT_PORCH) &&
            v_count <  (V_VISIBLE + V_FRONT_PORCH + V_SYNC_PULSE))
            vsync = 1'b0;
        else
            vsync = 1'b1;
    end

    // Area visibile + coordinate pixel
    
    assign video_on = (h_count < H_VISIBLE) && (v_count < V_VISIBLE);

    assign x = h_count;  // 0..639 quando video_on=1
    assign y = v_count;  // 0..479 quando video_on=1

endmodule
