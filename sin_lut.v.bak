module sin_lut(
    input  [3:0] idx,       				// indice LUT (0..9)
    output reg signed [7:0] sin_val		// è signed ma sono tutti positivi
);
reg signed [7:0] lut [0:9];
initial begin
    lut[0] = 8'b00010100; // 9° partendo da dx verso sx
    lut[1] = 8'b00111010; // 27°
    lut[2] = 8'b01011011; // 45°
    lut[3] = 8'b01110010; // 63°
    lut[4] = 8'b01111110; // 81°
    lut[5] = 8'b01111110; // 99°
    lut[6] = 8'b01110010; // 117°
    lut[7] = 8'b01011011; // 135°
    lut[8] = 8'b00111010; // 153°
    lut[9] = 8'b00010100; // 171°
end
always @(*) begin
    sin_val = lut[idx];
end
endmodule
